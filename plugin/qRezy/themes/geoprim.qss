
* { font-family: "Jost"; font-size: 9.5pt; }
QMainWindow, QDialog, QWidget { background: #1E1C1B; color: #ECE7DF; }
QMainWindow::separator { background: #4A4643; width: 1px; height: 1px; }
QMenuBar { background: #252321; color: #ECE7DF; border-bottom: 1px solid #4A4643; }
QMenuBar::item:selected { background: #2E2B29; }
QMenu { background: #1E1C1B; color: #ECE7DF; border: 1px solid #4A4643; }
QMenu::item:selected { background: #C9A46A; color: #1E1C1B; }
QMenu::item:disabled { color: #8C867E; }
QToolBar { background: #252321; border: none; border-bottom: 1px solid #4A4643; spacing: 2px; padding: 3px; }
QToolBar::separator { background: #4A4643; width: 1px; margin: 4px 6px; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 0px; padding: 3px; color: #ECE7DF; }
QToolButton:hover { background: #2E2B29; border-color: #4A4643; }
QToolButton:checked { background: #3A3127; border-color: #C9A46A; }
QDockWidget { color: #ECE7DF; titlebar-close-icon: none; }
QDockWidget::title { background: #252321; padding: 5px 8px; border-bottom: 1px solid #4A4643; text-transform: uppercase; }
QTreeView, QListView, QTableView, QTableWidget { background: #1E1C1B; alternate-background-color: #252321; color: #ECE7DF; border: 1px solid #4A4643; selection-background-color: #C9A46A; selection-color: #1E1C1B; gridline-color: #4A4643; }
QHeaderView::section { background: #252321; color: #D6CFC4; border: none; border-right: 1px solid #4A4643; padding: 4px; }
QTextEdit, QPlainTextEdit { background: #1E1C1B; color: #D6CFC4; border: 1px solid #4A4643; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #171615; color: #ECE7DF; border: 1px solid #4A4643; border-radius: 0px; padding: 3px 6px; selection-background-color: #C9A46A; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #C9A46A; }
QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { color: #8C867E; background: #1E1C1B; }
QComboBox QAbstractItemView { background: #1E1C1B; color: #ECE7DF; selection-background-color: #C9A46A; }
QComboBox::drop-down, QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { border: none; background: transparent; width: 14px; }
QPushButton { background: #252321; color: #ECE7DF; border: 1px solid #4A4643; border-radius: 0px; padding: 5px 12px; }
QPushButton:hover { border-color: #C9A46A; }
QPushButton:default { background: #C9A46A; color: #1E1C1B; border-color: #C9A46A; }
QCheckBox { color: #ECE7DF; spacing: 6px; }
QCheckBox::indicator { width: 13px; height: 13px; border: 1px solid #8C867E; border-radius: 2px; background: #171615; }
QCheckBox::indicator:checked { background: #C9A46A; border-color: #C9A46A; }
QSlider::groove:horizontal { height: 3px; background: #4A4643; border-radius: 1px; }
QSlider::sub-page:horizontal { background: #C9A46A; border-radius: 1px; }
QSlider::handle:horizontal { background: #ECE7DF; width: 12px; height: 12px; margin: -5px 0; border-radius: 6px; }
QGroupBox { border: 1px solid #4A4643; border-radius: 0px; margin-top: 14px; padding-top: 6px; color: #D6CFC4; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #C9A46A; }
QScrollBar:vertical { background: #1E1C1B; width: 10px; }
QScrollBar::handle:vertical { background: #4A4643; border-radius: 4px; min-height: 24px; }
QScrollBar:horizontal { background: #1E1C1B; height: 10px; }
QScrollBar::handle:horizontal { background: #4A4643; border-radius: 4px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QTabBar::tab { background: #252321; color: #D6CFC4; padding: 5px 12px; border: 1px solid #4A4643; }
QTabBar::tab:selected { background: #1E1C1B; color: #ECE7DF; border-bottom: 2px solid #C9A46A; }
QToolTip { background: #1E1C1B; color: #ECE7DF; border: 1px solid #C9A46A; padding: 4px; }
QLabel#rezyStatus { background: #252321; color: #D6CFC4; border-left: 3px solid #C9A46A; padding: 6px; }
QStatusBar { background: #252321; color: #D6CFC4; }
